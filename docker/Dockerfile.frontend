# syntax=docker/dockerfile:1
# Stage 1 — build frontend with node:20-alpine
FROM node:20-alpine AS build
WORKDIR /app

# Selective COPY — never copy the whole frontend/ dir (local node_modules/dist must not enter context)
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
# Workaround for npm optional-deps bug on alpine/musl (rollup native binding):
# package-lock.json was generated on glibc (WSL) — npm ci on musl skips the
# @rollup/rollup-linux-x64-musl optional dep (npm/cli#4828). Install it explicitly.
RUN npm install @rollup/rollup-linux-x64-musl --no-save 2>/dev/null || true

# Build inputs required by `vue-tsc --noEmit && vite build`
COPY frontend/tsconfig.json frontend/tsconfig.node.json frontend/vite.config.ts ./
COPY frontend/index.html ./
COPY frontend/public ./public
COPY frontend/src ./src

ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

# Stage 2 — serve with nginx:alpine
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
